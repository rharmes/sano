# No directory is browsable. Without this, mod_autoindex serves a full file listing
# for any directory that has no index file — /api/, /js/, /css/, /fonts/ and /audio/
# all did. Nothing secret lives in them, but a listing advertises every stray file
# that ever lands in a deployed directory, so this is the cheap half of not having
# to notice one. Inherited by every subdirectory (neither api/.htaccess nor any
# other overrides Options), so the single root directive covers the whole site.
Options -Indexes

Header set Cache-Control "no-cache" "expr=%{CONTENT_TYPE} =~ m#text/html#"
Header set Cache-Control "max-age=31536000, immutable" "expr=%{CONTENT_TYPE} == 'font/woff2'"
# Content-stamped (?v=hash) css/js never change under a given URL — cache them hard.
Header set Cache-Control "max-age=31536000, immutable" "expr=%{CONTENT_TYPE} =~ m#^(text/css|application/javascript|text/javascript)#"
# Service worker must always revalidate. This <Files> is applied after the rules
# above, so its no-cache wins over the js rule for /sw.js.
<Files "sw.js">
    Header set Cache-Control "no-cache"
</Files>

# Compress text responses. The shared host already gzips; codifying it keeps the
# behavior in the repo and portable (mod_deflate won't double-compress).
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# Security headers (`always` so they cover error responses too). The app makes no
# external requests at runtime, so the CSP is tight: scripts are all external
# same-origin files (no inline <script>), and style-src needs 'unsafe-inline' only
# for the inline style attributes JS sets (animation-delay) and the inline sprite
# <svg style>. frame-ancestors 'none' blocks clickjacking of the login.
Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
# HTTPS only (session cookie is Secure). Add includeSubDomains/preload once every
# browser-facing subdomain is confirmed HTTPS.
Header always set Strict-Transport-Security "max-age=31536000"
