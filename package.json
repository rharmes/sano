{
	"name": "sano",
	"private": true,
	"description": "Tooling deps only (Prettier + PHP plugin). The app itself has no build step.",
	"scripts": {
		"start": "php -S 127.0.0.1:8000",
		"stop": "kill $(lsof -ti tcp:8000) 2>/dev/null || true",
		"format": "tools/format.sh",
		"lint": "tools/check.sh",
		"test": "tools/test.sh",
		"test:unit": "node --test tests/unit/*.test.mjs",
		"test:data": "node --test tests/data/*.test.mjs",
		"test:api": "playwright test tests/api",
		"test:e2e": "playwright test tests/e2e",
		"check": "tools/test.sh",
		"stamp": "node tools/stamp-version.mjs",
		"deploy:preview": "tools/deploy.sh -n",
		"deploy": "tools/deploy.sh"
	},
	"devDependencies": {
		"@playwright/test": "^1.61.1",
		"@prettier/plugin-php": "0.25.0",
		"prettier": "3.8.3"
	}
}
