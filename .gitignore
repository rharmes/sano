design/devanagari-review.json
design/devanagari-review.json.bak

# Vocabulary-expansion staging (T11), all transient pre-merge working data:
#   -candidates.json  = mechanical output of tools/dict/select-candidates.mjs
#   -draft.json       = the AI-drafted batch reviewed in design/expansion.html
#   -approved.json    = Ross's approve/reject decisions (design/expansion-save.php)
# Approved rows are merged into js/data.js by hand, then these can be cleared.
design/expansion-candidates.json
design/expansion-draft.json
design/expansion-approved.json
design/expansion-approved.json.bak

# Depth frames-review staging (T31), transient pre-merge working data:
#   -draft.json    = the AI-drafted candidate frames reviewed in design/frames.html
#   -approved.json = Ross's approve/reject decisions (design/frames-save.php)
# Approved frames are merged into the items' `frames: []` in js/data.js by hand, then cleared.
design/frames-draft.json
design/frames-approved.json
design/frames-approved.json.bak

# Playwright test artifacts (regenerated every run; never committed/deployed).
/test-results/
/playwright-report/
/blob-report/

# Dictionary tool (tools/dict): raw corpora + Claude response cache stay local.
# Only the derived dictionary.json / coverage-report.md / sources.lock.json are committed.
tools/dict/sources/
tools/dict/cache/
tools/dict/_sample/
